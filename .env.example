# ====================================================================
# SDF 1 İMTAHAN PORTALI — NÜMUNƏ MÜHİT FAYLI (.env.example)
# Bu fayl şablon xarakteri daşıyır və təhlükəsiz şəkildə repoda saxlanıla bilər.
# İstifadə etmək üçün bu faylı `.env` olaraq kopyalayın və dəyərləri yazın.
# ====================================================================

# Supabase Verilənlər Bazası Qoşulması
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Müəllim Paneli və İmtahan İdarəetmə Şifrəsi
ADMIN_PASSWORD="your_secure_password"
ADMIN_PASSWORD_HASH="your_sha256_hash_here"
